# PostgreSQL connection string used by Payload's Postgres adapter.
DATABASE_URI=
# Secret used to sign Payload JWTs and other cryptographic operations. Generate a long random value; never reuse across environments.
PAYLOAD_SECRET=
# Public base URL of the deployed app. Used to build absolute, trusted URLs (e.g. password-reset links) — do not derive these from request headers.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=fr

# Persistent storage for Payload media. Vercel creates this when a public Blob store is connected to the project.
BLOB_READ_WRITE_TOKEN=

# --- Transactional email (password reset) ---
# Required in production (validated at startup). Optional in development —
# without them, reset emails are printed to the console instead of sent.
# Works with any SMTP-speaking provider: OVH's own SMTP relay, SES, Postmark, Brevo, self-hosted, etc.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# "true" for implicit TLS (typically port 465); leave unset for STARTTLS (typically port 587).
SMTP_SECURE=

# --- Seed script guard (see src/scripts/seed.ts) ---
# Must be "true" to allow the seed script to run when NODE_ENV=production. Never set this in a real production environment unless deliberately reseeding.
ALLOW_SEED=
# Bootstrap admin account created by the seed script. Required for the seed script to create an admin user; the password is never logged.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
